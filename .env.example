# 生成方式（PowerShell）：
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
RATEWATCH_MASTER_KEY=请替换为32字节随机值的Base64
RATEWATCH_SESSION_SECRET=请替换为另一组32字节随机值的Base64
RATEWATCH_ADDR=:8080
RATEWATCH_DB=/data/ratewatch.db
RATEWATCH_PUBLIC_URL=http://localhost:8080

# 平台统一发件账号；留空 RATEWATCH_SMTP_HOST 即关闭邮件发送
RATEWATCH_SMTP_HOST=
RATEWATCH_SMTP_PORT=587
RATEWATCH_SMTP_USER=
RATEWATCH_SMTP_PASSWORD=
RATEWATCH_SMTP_FROM=

# 默认调度周期
RATEWATCH_POLL_INTERVAL=45s
RATEWATCH_PROBE_INTERVAL=5m
RATEWATCH_MODEL_INTERVAL=30m
RATEWATCH_EMAIL_INTERVAL=10m

